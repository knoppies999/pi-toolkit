{
	"name": "pi-toolkit",
	"version": "0.3.0",
	"description": "Pi package: a safety guard, subagents, Azure DevOps and dotnet tools, and skills for tickets, reviews, .NET, TypeScript, Vitest and Playwright",
	"type": "module",
	"license": "MIT",
	"author": "knoppies999",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/knoppies999/pi-toolkit.git"
	},
	"keywords": [
		"pi-package",
		"pi",
		"azure-devops",
		"dotnet"
	],
	"files": [
		"extensions",
		"agents",
		"skills",
		"prompts",
		"CHANGELOG.md",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"extensions/guard/index.ts",
			"extensions/azure-devops/index.ts",
			"extensions/dotnet/index.ts",
			"extensions/subagent/index.ts"
		],
		"skills": [
			"skills/*"
		],
		"prompts": [
			"prompts/*.md"
		]
	},
	"scripts": {
		"check": "tsc --noEmit",
		"test": "node --test \"tests/**/*.test.ts\""
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "^1.4.0",
		"@earendil-works/pi-coding-agent": "^1.4.0",
		"@types/node": "^24.0.0",
		"typebox": "^1.3.27",
		"typescript": "^5.9.3"
	},
	"engines": {
		"node": ">=22.19"
	}
}
